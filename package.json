{
  "name": "atap-tennis-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/src/index.js",
    "dev:all": "concurrently \"vite\" \"node server/src/index.js\"",
    "build": "vite build && node -e \"const fs=require('fs'); fs.cpSync('api', 'dist/api', {recursive:true});\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
